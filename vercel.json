{
  "version": 2,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "functions": {
    "api/[...all].js": {
      "includeFiles": "{server/**,dist/*.html,dist/*.xml,dist/*.txt,dist/blog/**,dist/product/**,dist/patterns/**}",
      "excludeFiles": "{dist/images/**,dist/assets/**}"
    }
  },
  "headers": [
    {
      "source": "/(.*)\\.pdf",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" }
      ]
    },
    {
      "source": "/server/storage/(.*)",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" }
      ]
    },
    {
      "source": "/storage/(.*)",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/images/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=86400, stale-while-revalidate=604800" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/api", "destination": "/api/[...all]" },
    { "source": "/api/(.*)", "destination": "/api/[...all]" },
    { "source": "/admin", "destination": "/api/[...all]" },
    { "source": "/admin/(.*)", "destination": "/api/[...all]" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
