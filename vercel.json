{
  "version": 2,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "functions": {
    "api/index.js": {
      "includeFiles": "{server/**,dist/**}"
    },
    "api/[...all].js": {
      "includeFiles": "{server/**,dist/**}"
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/[...all]" },
    { "source": "/admin", "destination": "/api/index" },
    { "source": "/admin/(.*)", "destination": "/api/[...all]" },
    { "source": "/product/(.*)", "destination": "/api/[...all]" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
