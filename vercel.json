{
  "version": 2,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "functions": {
    "api/[...all].js": {
      "includeFiles": "{server/**,dist/*.html,dist/*.xml,dist/*.txt,dist/blog/**,dist/product/**}",
      "excludeFiles": "{dist/images/**,dist/assets/**}"
    }
  },
  "rewrites": [
    { "source": "/api", "destination": "/api/[...all]" },
    { "source": "/api/(.*)", "destination": "/api/[...all]" },
    { "source": "/admin", "destination": "/api/[...all]" },
    { "source": "/admin/(.*)", "destination": "/api/[...all]" },
    { "source": "/blog/(.*)", "destination": "/api/[...all]" },
    { "source": "/product/(.*)", "destination": "/api/[...all]" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
